<div class="flex items-center text-sm sm:text-base mt-2 font-medium">
  <div class="shrink-0 mr-2 flex items-center">
    <span class="text-[#27c93f]">camilo@dev</span>
    <span class="text-white">:</span>
    <span class="text-blue-400">~</span>
    <span class="text-white">$</span>
  </div>
  
  <form id="terminal-form" class="flex-1 flex items-center relative">
    <input 
      id="terminal-input"
      type="text"
      autocomplete="off"
      spellcheck="false"
      autofocus
      class="w-full bg-transparent border-none outline-none focus:ring-0 text-gray-200 p-0 m-0 caret-gray-300"
    />
  </form>
</div>

<script>
  import { initTerminal } from '../../terminal/engine';
  initTerminal();
</script>